# =====================================================================
# Roteamento do AppTrena (Angular)
#
# O Angular controla as rotas no navegador: /obras, /eap e as demais não
# existem como pastas no servidor. Sem estas regras, abrir um link direto
# ou dar F5 numa tela interna resultaria em erro 404 — o servidor
# procuraria um arquivo que não existe.
#
# A regra abaixo entrega o index.html para qualquer caminho que não seja
# um arquivo real, e o Angular resolve a rota a partir daí.
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /novo/

  # Arquivos e pastas que existem de verdade são servidos normalmente.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------
# Os arquivos JS e CSS têm o conteúdo no nome (main-A1B2C3.js), então
# podem ser guardados para sempre: qualquer alteração gera um nome novo.
# Já o index.html nunca pode ser cacheado — é ele que aponta para os
# nomes novos, e um index velho carregaria a versão antiga do app.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# Compressão
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
