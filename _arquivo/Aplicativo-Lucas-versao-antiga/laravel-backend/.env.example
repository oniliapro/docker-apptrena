APP_NAME="Controle de Obra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=controle_obra
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# CORS: se o front (html/*.html) rodar em outra origem (outra porta),
# ajuste config/cors.php ou instale laravel/sanctum para servir o front e
# a API na mesma origem.

# Leitura de nota fiscal por IA (módulo Pagamentos). Cole sua chave da
# Anthropic Console aqui quando tiver uma. Sem isso, o recurso fica desligado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
